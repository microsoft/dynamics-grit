{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "CRM.CCaaS.IVR.GRammarImportTool.ApiService": "Information"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Main": {
    "MaxConcurrentUpgradedConnections": 500,
    "MaxConcurrentConnections": 500,
    "Http2MaxStreamsPerConnection": 100,
    "HttpPlainTextPort": 5003,
    "HttpSslPort": 8443
  }
}
