{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "CRM.CCaaS.IVR.GRammarImportTool.ApiService": "Information",
      "Microsoft.AspNetCore.Server.Kestrel": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Main": {
    "MaxConcurrentUpgradedConnections": 500,
    "MaxConcurrentConnections": 500,
    "Http2MaxStreamsPerConnection": 100,
    "HttpPlainTextPort": 5003,
    "HttpSslPort": 8443
  },
  "GptChat": {
    "Grxml": {
      "HashFileNamesInLogs": false,
      "MaxTokenLimit": 10000
    }
  }
}
