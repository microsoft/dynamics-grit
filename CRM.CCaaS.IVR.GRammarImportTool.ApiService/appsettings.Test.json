{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "KeepAliveTimeout": "01:00:00",
      "RequestHeadersTimeout": "01:00:00"
    }
  },
  "Main": {
    "MaxConcurrentUpgradedConnections": 500,
    "MaxConcurrentConnections": 500,
    "Http2MaxStreamsPerConnection": 100,
    "HttpPlainTextPort": 5003,
    "HttpSslPort": 5002
  },
  "GptChat": {
    "Grxml": {
      "OpenAI_Provider": "AzureOpenAI",
      "AzureOpenAIEndpoint": "http://localhost:5001",
      "AzureOpenAIDeploymentName": "test",
      "AzureOpenAIKey": "fake-key-stub-accepts-all",
      "MaxTokenLimit": 10000
    }
  }
}
