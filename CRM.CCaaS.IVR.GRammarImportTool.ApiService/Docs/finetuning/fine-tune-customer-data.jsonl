eacode; \\n\\t </tag>\\n       </item>\\n       <item>\\n         <ruleref uri=\"#area_non_geographic\"/>\\n         <tag> \\n\\t   areacode_rule=\"area_non_geographic\"; \\n\\t   areacode=area_non_geographic.area; \\n\\t   SWI_meaning=areacode; \\n\\t </tag>\\n       </item>\\n     </one-of>\\n\\n     <ruleref uri=\"#sevendigitphone\"/>\\n     <tag>\\n       seven=sevendigitphone.seven;\\n       if(SWI_meaning == areacode) { \\n\\t SWI_meaning = SWI_meaning + seven;\\n\\t dm_root = SWI_meaning;\\n       }\\n       else { dm_command = SWI_meaning; }\\n     </tag>\\n  </rule>\\n  <!-- The rest of the file omitted because of length, structured similarly listing various area codes and digit patterns -->\\n</grammar>\"}; "
