ECOY.\" + DECOY.SWI_literal;\n\t\t\t\tSWI_decoy = 1;\n\t\t\t\teRxNumber = '';\n\t\t\t\teHoldOnOrDontKnow = 'NULL';\n\t\t\t\teDob = 'NULL';\n\t\t\t</tag>\n\t\t</item>\t\t\t\t\t\t\t\t\t\t  \n\t\t\n      </one-of>\n    </rule>\n\n    <rule id=\"vocab\" scope=\"public\">\t\n\t  <tag>\n\t\t<![CDATA[\n\n\t\t\t  /* *************************************************************************************** \n\t\t   * Set default SWI_vars in case none are passed in */\n\n\t\t  /* Allowed/expected range values: */ \n\t\t\t  \n\t\t\t\t  SWI_vars.offsetunit = 'y' // possible values: 'd', 'm', or 'y'\n\t\t\t\t  SWI_vars.minallowed = '-110';  // can be absolute or relative\n\t\t\t\t  SWI_vars.maxallowed = '0';   // can be absolute or relative\n\t\t\t\t  SWI_vars.minexpected = '-80';  // can be absolute or relative\n\t\t\t\t  SWI_vars.maxexpected = '-10';  // can be absolute or relative\n\t\t\t\t\n\n\t\t  /* Disambiguation mode possible values: 'assume_nothing', 'assume_expected', 'assume_closest', \n\t\t\t\t\t\t\t\t\t\t\t\t\t  'assume_closest_past', 'assume_closest_future', 'assume_past', 'assume_future' */\n\t\t\t  if(!SWI_vars.disambiguationmode) { SWI_vars.disambiguationmode = 'assume_closest_past'; }\n\n\t\t  /* var to control SWI_disallow penalty to apply to dates outside expected range */\n\t\t  if(!SWI_vars.notexpecteddelta) { SWI_vars.notexpecteddelta = '-100'; }\n\t\t]]>\n      </tag>\n\t  \n      <item repeat=\"0-1\"> <ruleref uri=\"#PREFIX_DOB\"/> </item>\n      <ruleref uri=\"date_of_birth.grxml#_date?SWI_vars=SWI_vars\"/>\n      <tag>\n\t\tSWI_meaning=_date.SWI_meaning; \n\t\tif(_date.RAW_DATE) {\n\t\t  if(_date.RAW_DATE.substr(0,2) == '??') { LENGTH = 6; }\n\t\t  else { LENGTH = 8; }\n\t\t}\n\t\telse { LENGTH = '?'; }\t\t\n      </tag>\n    </rule>\n\n  <rule id=\"HoldOn\" scope=\"public\">\n      <one-of>\n        <item>\n              <one-of>\n\t\t\t\t<item> hold <item repeat=\"0-1\"> on </item> </item>\n\t\t\t\t<item> hang on </item>\n\t\t\t\t<item> wait </item>     \t\t\t\t\n              </one-of>\n              <item repeat=\"0-1\">\n                <one-of>\n                    <item> a sec </item>\n                    <item> a second </item>\n                    <item> one second </item>\n                    <item> a minute </item>\n                    <item> one minute </item>\n                    <item> <item repeat=\"0-1\">for</item> a minute </item>\n                    <item> one moment </item>\n                    <item> <item repeat=\"0-1\">for</item> a moment </item>\n                </one-of>\n            </item>\n        </item>\t\n\n\t\t<item> give me a second</item>\n\t\t<item> give me a minute</item>\n        <item repeat=\"1-2\"> one second </item>\n        <item repeat=\"1-2\"> one minute </item>\n        <item repeat=\"1-2\"> one moment </item>\n        <item repeat=\"1-2\"> hold on </item>\n\n\t\t<item>one moment</item>\n\n      </one-of>\n\n\t  <item repeat=\"0-1\" repeat-prob=\"0.001\"> please </item>  \n\n  </rule>\n\n   \n\t<rule id=\"DontKnow\" scope=\"public\">\n      <one-of>\n          <item>\n              <item repeat=\"0-1\" repeat-prob=\"0.1\">i</item>\n              <item repeat=\"0-1\"> i </item>\n              <one-of>\n                  <item> don't</item>\n                  <item> do not </item>\n              </one-of>\n              <one-of>\n                  <item> know </item>\n                  <item> remember </item>\n              </one-of>\n              <item repeat=\"0-1\">\n                  <one-of>\n                      <item>  it </item>\n                      <item>  that </item>\n                      <item>  one </item>\n\t\t\t\t\t  <item>  <item repeat=\"0-1\">the</item> <item repeat=\"0-1\">r x</item> number </item>\n\t\t\t\t\t  <item>  <item repeat=\"0-1\">the</item> <item repeat=\"0-1\">r_x</item> number </item>\n                  </one-of>  \n              </item>\n          </item>\n          <item weight=\"0.01\"> i dunno <item repeat=\"0-1\"> it </item> </item>\n          <item weight=\"0.01\"> dunno it </item>\n          <item> <item repeat=\"0-1\"> i </item> have no idea </item> \n          <item> i don't know it <item repeat=\"0-1\">i</item> don't know <item repeat=\"0-1\">it</item> </item>\n          <item> i've no clue </item> \n          <item> i have no clue </item>\n\t\t  <item><item repeat='0-1'>i'm</item>not sure</item>\n          <item weight=\"0.01\"> unknown </item> \n\t\t  <item>\n              <item repeat=\"0-1\" repeat-prob=\"0.1\">i</item>\n"
