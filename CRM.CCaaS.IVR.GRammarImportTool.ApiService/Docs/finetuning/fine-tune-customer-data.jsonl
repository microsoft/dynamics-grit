 SWI_disallow=1;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tif (include_it == 0){SWI_disallow = 1}\\n\\t\\t\\t\\telse {\\t\\t\\t\\t\\n\\t\\t\\t\\t\\tif(vocab.SWI_meaning) {SWI_meaning=vocab.SWI_meaning};\\n\\t\\t\\t\\t\\teDepartment=SWI_meaning; \\t\\t\\t\\t       \\n\\t\\t\\t\\t}\\n            </tag>\\n            </item>\\n        </one-of>\\n    </rule>\\n\\n    <rule id=\"vocab\" scope=\"public\">\\n        <item repeat='0-1' repeat-prob='0.01'><ruleref uri=\"#PREFIX\"/></item>\\n        <item>\\n            <one-of>\\n                <item>\\n                    <tag>SWI_meaning='different_dept';</tag>\\n\\t\\t\\t\\t\\t\\t<one-of>\\n\\t\\t\\t\\t\\t\\t\\t<item> different </item>\\n\\t\\t\\t\\t\\t\\t\\t<item> a different one </item>\\n\\t\\t\\t\\t\\t\\t\\t<item> different department </item>\\n\\t\\t\\t\\t\\t\\t\\t<item> it's a different one </item>\\n\\t\\t\\t\\t\\t\\t</one-of>\\n\\t\\t\\t\\t\\t\\t<item repeat='0-1'>please</item>\\n                </item>\\n\\n                <item>\\n                    <tag>SWI_meaning='advise';</tag>\\n\\t\\t\\t\\t\\t\\t<one-of>\\n\\t\\t\\t\\t\\t\\t\\t<item> advise </item>\\n\\t\\t\\t\\t\\t\\t</one-of>\\n\\t\\t\\t\\t\\t\\t<item repeat='0-1'>please</item>\\n                </item>\\n\\t\\t\\t\\t\\n                <item>\\n                    <tag>SWI_meaning='billing_spec';</tag>\\n\\t\\t\\t\\t\\t\\t<one-of>\\n\\t\\t\\t\\t\\t\\t\\t<item> billing <item repeat='0-1'> spec </item></item>\\n\\t\\t\\t\\t\\t\\t</one-of>\\n\\t\\t\\t\\t\\t\\t<item repeat='0-1'>please</item>\\n                </item>\\n\\t\\t\\t\\t\\n                <item>\\n                    <tag>SWI_meaning='clinic';</tag>\\n\\t\\t\\t\\t\\t\\t<one-of>\\n\\t\\t\\t\\t\\t\\t\\t<item> clinic </item>\\n\\t\\t\\t\\t\\t\\t</one-of>\\n\\t\\t\\t\\t\\t\\t<item repeat='0-1'>please</item>\\n                </item>\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n                <item>\\n                    <tag>SWI_meaning='compounding';</tag>\\n\\t\\t\\t\\t\\t\\t<one-of>\\n\\t\\t\\t\\t\\t\\t