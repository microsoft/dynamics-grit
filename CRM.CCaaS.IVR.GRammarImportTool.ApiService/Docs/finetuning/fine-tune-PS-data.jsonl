T'><item><ruleref uri='#CCEXPDATE'/><tag>_V1_1=CCEXPDATE.VALUE;</tag></item><tag>VALUE=_V1_1;</tag></rule><rule id='CCEXPDATE'><one-of><item><ruleref uri='#AMBIG_MONTH'/><item repeat='0-1'>slash</item><ruleref uri='#YEAR_FULL'/><tag>VALUE='';try{VALUE+=YEAR_FULL.VALUE;}catch(e){}finally{};VALUE+=' ';try{VALUE+=AMBIG_MONTH.VALUE;}catch(e){}finally{};</tag></item><item><ruleref uri='#MONTH'/><item repeat='0-1'>slash</item><ruleref uri='#YEAR_FULL'/><tag>VALUE='';try{VALUE+=YEAR_FULL.VALUE;}catch(e){}finally{};VALUE+=' ';try{VALUE+=MONTH.VALUE;}catch(e){}finally{};</tag></item><item><ruleref uri='#AMBIG_MONTH'/><item repeat='0-1'>slash</item><ruleref uri='#YEAR_NOCENT'/><tag>VALUE='?? ';try{VALUE+=YEAR_NOCENT.VALUE;}catch(e){}finally{};VALUE+=' ';try{VALUE+=AMBIG_MONTH.VALUE;}catch(e){}finally{};</tag></item><item><ruleref uri='#MONTH'/><item repeat='0-1'>slash</item><ruleref uri='#YEAR_NOCENT'/><tag>VALUE='?? ';try{VALUE+=YEAR_NOCENT.VALUE;}catch(e){}finally{};VALUE+=' ';try{VALUE+=MONTH.VALUE;}catch(e){}finally{};</tag></item></one-of></rule></grammar>"}, {"role": "assistant", "content": "entity_type: Prebuilt entity\nreason: The GRXML grammar captures credit card expiration dates, which represent a date format. This should be mapped directly to the prebuilt 'Date' entity in Copilot Studio, as 'Date' entity covers month-year data, suitable for credit card expiration scenarios.\ncopilot_studio_code: |\n  - kind: PrebuiltEntityComponent\n    displayName: ccexpdate\n    prebuiltEntityName: Date\n    state: Active\n    status: Active"}]}
