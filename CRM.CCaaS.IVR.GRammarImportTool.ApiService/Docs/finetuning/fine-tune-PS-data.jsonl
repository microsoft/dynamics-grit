e\n    status: Active\n    schemaName: DL_MD\n    entity:\n      kind: RegexEntity\n      regexPattern: '^[A-Z]+\\d{3}-?\\d{3}-?[A-Z0-9]+$' \n      isCaseSensitive: false\n      isUnicode: false"}]}
