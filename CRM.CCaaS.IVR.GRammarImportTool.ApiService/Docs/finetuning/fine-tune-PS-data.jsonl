{"messages": [{"role": "user", "content": "Convert the file phone_valid_npas to Microsoft Copilot Studio Yaml.  File content:      <grammar version='1.0' xml:lang='fr-ca' xmlns='http://www.w3.org/2001/06/grammar' root='_phone'><rule id='_phone' scope='public'><ruleref uri='#phonenumber'/><tag>areacode=phonenumber.areacode; sevendigitphone=phonenumber.seven;if(phonenumber.areacode_rule){areacode_rule=phonenumber.areacode_rule;}if(phonenumber.has_prefix){has_prefix=phonenumber.has_prefix;}if(phonenumber.has_restart){has_restart=phonenumber.has_restart;}if(phonenumber.SWI_meaning){SWI_meaning=phonenumber.SWI_meaning;}else{SWI_meaning=areacode+sevendigitphone;}if(phonenumber.dm_root){dm_root=phonenumber.dm_root;}if(phonenumber.dm_command){dm_command=phonenumber.dm_command;}MEANING=SWI_meaning;</tag><ruleref uri='#phonenumber'/></rule><rule id='phonenumber' scope='public'><item repeat='0-1'><ruleref uri='#_prefix'/><tag>has_prefix=1;</tag></item><one-of><item><ruleref uri='#area_canada_french'/><tag>areacode_rule='area_canada_french';areacode=area_canada_french.area;if(area_canada_french.has_restart){has_restart=area_canada_french.has_restart;}SWI_meaning=areacode;</tag></item><item><ruleref uri='#area_canada_other'/><tag>areacode_rule='area_canada_other';areacode=area_canada_other.area;if(area_canada_other.has_restart){has_restart=area_canada_other.has_restart;}SWI_meaning=areacode;</tag></item><item><ruleref uri='#area_usa'/><tag>areacode_rule='area_usa';areacode=area_usa.area;if(area_usa.has_restart){has_restart=area_usa.has_restart;}SWI_meaning=areacode;</tag></item><item><ruleref uri='#area_usa_territories'/><tag>areacode_rule='area_usa_territories';areacode=area_usa_territories.area;if(area_usa_territories.has_restart){has_restart=area_usa_territories.has_restart;}SWI_meaning=areacode;</tag></item><item><ruleref uri='#area_caribbean'/><tag>areacode_rule='area_caribbean';areacode=area_caribbean.area;if(area_caribbean.has_restart){has_restart=area_caribbean.has_restart;}SWI_meaning=areacode;</tag></item><item><ruleref uri='#area_non_geographic'/><tag>areacode_rule='area_non_geographic';areacode=area_non_geographic.area;if(area_non_geographic.has_restart){has_restart=area_non_geographic.has_restart;}SWI_meaning=areacode;</tag></item></one-of><ruleref uri='#sevendigitphone'/><tag>seven=sevendigitphone.seven;if(SWI_meaning==areacode){SWI_meaning=SWI_meaning+seven;dm_root=SWI_meaning;}else{dm_command=SWI_meaning;}</tag></rule><rule id='_prefix'><one-of><item>un</item><item><item repeat='0-1'>un</item><one-of><item>code</item><item>indicatif</item></one-of>régional</item></one-of></rule><rule id='sevendigitphone' scope='public'><ruleref uri='#digit29'/><tag>seven=digit29.digit</tag><one-of><item><ruleref uri='#digit09'/><tag>seven+=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>seven+=''+digit09.digit</tag></item><item><ruleref uri='#twodigits'/><tag>seven+=''+twodigits.digits</tag></item><item><tag>seven+='00'</tag>cent</item></one-of><ruleref uri='#digitlastfour'/><tag>seven+=''+digitlastfour.digit4</tag></rule><rule id='digitlastfour' scope='public'><one-of><item><ruleref uri='#digit09'/><tag>digit4=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag></item><item><ruleref uri='#twodigits'/><tag>digit4=''+twodigits.digits</tag><ruleref uri='#twodigits'/><tag>digit4+=''+twodigits.digits</tag></item><item><ruleref uri='#digit09'/><tag>digit4=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag><ruleref uri='#twodigits'/><tag>digit4+=''+twodigits.digits</tag></item><item><ruleref uri='#twodigits'/><tag>digit4=''+twodigits.digits</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag><ruleref uri='#digit09'/><tag>digit4+=''+digit09.digit</tag></item><item><tag>digit4='1000'</tag>mille<item repeat='0-1'><ruleref uri='#digit19'/><tag>digit4='100'