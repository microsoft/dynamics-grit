d list. The complexity and variability clearly requires a Regex-based custom entity to reliably interpret and capture these license formats.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_MT\n    state: Active\n    status: Active\n    schemaName: DL_MT\n    entity:\n      kind: RegexEntity\n      regexPattern: '(([A-J][0-9][0-9ABC][0-3][0-9][A-Z][A-Z*]{2}[0-1])|([A-Z][0-9]{8})|(([0-9]{9}(0000)?)|((0[0-9]|1[0-9]|2[0-9]|3[0-9]|40|41)([0-9]))))[0-9]*'\n      caseSensitive: false\n      extractionMethod: Regex"}]}
