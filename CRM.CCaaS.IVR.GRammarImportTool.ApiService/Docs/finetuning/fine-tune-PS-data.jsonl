gths. Such structured, pattern-based content is accurately represented using regular expressions.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_MO\n    state: Active\n    status: Active\n    schemaName: DL_MO\n    entity:\n      kind: RegexEntity\n      regex: '([A-Za-z]\\d{9})|(([LlEe])\\d{6}[Rr])|([A-Za-z]\\d{5,8})'"}]}
