s RegexEntity.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_LA\n    state: Active\n    status: Active\n    schemaName: DL_LA\n    entity:\n      kind: RegexEntity\n      regexPattern: ^((00|01)\\d{7}|\\d{7})$ \n      ignoreCase: true"}]}
