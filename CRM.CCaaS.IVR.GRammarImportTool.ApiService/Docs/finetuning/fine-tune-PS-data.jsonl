igit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag></item><item><ruleref uri='#digit2_9'/><tag>V=(V?V:'')+digit2_9.V;</tag><ruleref uri='#twodigits'/><tag>V=V+twodigits.V;</tag></item></one-of></rule><rule id='four_digits' scope='public'><one-of><item><ruleref uri='#digit0_9'/><tag>V=(V?V:'')+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag></item><item><ruleref uri='#digit0_9'/><tag>V=(V?V:'')+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#twodigits'/><tag>V=V+twodigits.V;</tag></item><item><ruleref uri='#twodigits'/><tag>V=(V?V:'')+twodigits.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag></item><item><ruleref uri='#twodigits'/><tag>V=(V?V:'')+twodigits.V;</tag><ruleref uri='#twodigits'/><tag>V=V+twodigits.V;</tag></item></one-of></rule><rule id='four_digits' scope='public'><one-of><item><ruleref uri='#digit0_9'/><tag>V=(V?V:'')+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag><ruleref uri='#digit0_9'/><tag>V=V+digit0_9.V;</tag></item></one-of></rule><rule id='twodigits' scope='public'><one-of><item>diez<tag>V='10'</tag></item></one-of></rule><rule id='digit0_9' scope='public'><one-of><item>uno<tag>V='1'</tag></item><item>dos<tag>V='2'</tag></item><item>tres<tag>V='3'</tag></item><item>cuatro<tag>V='4'</tag></item><item>cinco<tag>V='5'</tag></item><item>seis<tag>V='6'</tag></item><item>siete<tag>V='7'</tag></item><item>ocho<tag>V='8'</tag></item><item>nueve<tag>V='9'</tag></item><item>cero<tag>V='0'</tag></item></one-of></rule><rule id='digit2_9' scope='public'><one-of><item>dos<tag>V='2'</tag></item><item>tres<tag>V='3'</tag></item><item>cuatro<tag>V='4'</tag></item><item>cinco<tag>V='5'</tag></item><item>seis<tag>V='6'</tag></item><item>siete<tag>V='7'</