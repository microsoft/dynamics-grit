\"dos\" represented as \"1\" or \"2\"). This structured numeric-alphanumeric input should be represented as a RegexEntity in Copilot Studio for improved accuracy and flexibility.\ncopilot_studio_code: |\n    - kind: CustomEntityComponent\n      displayName: DL_PE\n      state: Active\n      status: Active\n      schemaName: DL_PE\n      entity:\n        kind: RegexEntity\n        regexPattern: '(^\\d{1,6}$)|(^\\d{4}(0[1-9]|[12][0-9]|3[01])(0[1-9]|1[012])\\d{2}[12]\\d$)'\n        errorMessage: Por favor, ingresa un número de licencia de conducir válido.\n        sensitive: false"}]}
