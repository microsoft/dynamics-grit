ession-based entity.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DriversLicenseNumber\n    state: Active\n    status: Active\n    schemaName: DriversLicenseNumber\n    entity:\n      kind: RegexEntity\n      regexPattern: '^(0\\d{8}|10\\d{7}|\\d{7})$'\n      isCaseSensitive: false\n      isMultiline: false"}]}
