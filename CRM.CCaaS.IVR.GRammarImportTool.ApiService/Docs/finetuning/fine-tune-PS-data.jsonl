ic patterns are best represented using a regular expression entity in Copilot Studio.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_IL\n    state: Active\n    status: Active\n    schemaName: DL_IL\n    entity:\n      kind: RegexEntity\n      regexPattern: '^[A-Za-z]+-?\\d{4}-?\\d{4}$|^[A-Za-z]+\\d{8}[A-Za-z]$'"}]}
