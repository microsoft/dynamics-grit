ing regular expression entities.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_AS\n    state: Active\n    status: Active\n    schemaName: DL_AS\n    entity:\n      kind: RegexEntity\n      regexPattern: '(^\\d{9}$)|(^E\\d{1,7}$)|(^PT\\d{1,9}$)|(^ID\\d{5}$)|(^\\d{6}$)'\n      isCaseSensitive: false"}]}
