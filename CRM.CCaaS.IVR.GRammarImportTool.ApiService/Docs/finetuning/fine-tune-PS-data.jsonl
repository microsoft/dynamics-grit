tudio to effectively capture multiple possible variations as defined by the rules.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_VI\n    state: Active\n    status: Active\n    schemaName: DL_VI\n    entity:\n      kind: RegexEntity\n      regexPattern: '(^[A-Za-z]?\\d{9}$)|(^[TtCc]\\d{10,11}$)|(^[Jj]\\d{10}$)|(^[A-Za-z]\\d{12}$)'\n      isCaseSensitive: false\n      isMultiline: false"}]}
