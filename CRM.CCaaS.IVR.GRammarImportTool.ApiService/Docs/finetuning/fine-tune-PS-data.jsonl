oo complex for a prebuilt entity or a custom list entity due to patterns involving repeated alphabetic and numeric sequences. Therefore, it is best represented by Custom Regex entity in Copilot Studio.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_MO\n    state: Active\n    status: Active\n    schemaName: DL_MO\n    entity:\n      kind: RegexEntity\n      regexPattern: '(^[A-Za-z]?\\d{9}$)|(^[LE]\\d{6}R$)|(^[A-Za-z]\\d{5,8}$)'"}]}
