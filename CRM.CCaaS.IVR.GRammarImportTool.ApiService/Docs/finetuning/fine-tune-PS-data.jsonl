nct and regular input formats rather than interchangeable synonyms or natural language phrases.\ncopilot_studio_code: |\n  - kind: CustomEntityComponent\n    displayName: DL_BC\n    state: Active\n    status: Active\n    schemaName: DL_BC\n    entity:\n      kind: RegexEntity\n      regexPattern: '(?:\\d{7}|\\d{9}|ID\\d{5}|BC1\\d{8})'"}]}
