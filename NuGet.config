<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <solution>
      <!-- This is necessary to prevent nuget from adding packages and their content to source control. -->
      <add key="disableSourceControlIntegration" value="true" />
  </solution>
  <packageSources>
    <clear />
    <add key="CRMUnified" value="https://pkgs.dev.azure.com/dynamicscrm/_packaging/CRMUnified/nuget/v3/index.json" />
   </packageSources>
 <packageSourceMapping>
    <packageSource key="CRMUnified">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageRestore>
    <!-- Allow NuGet to download missing packages -->
    <add key="enabled" value="True" />
    <!-- Automatically check for missing packages during build in Visual Studio -->
    <add key="automatic" value="True" />
   </packageRestore>
</configuration>
